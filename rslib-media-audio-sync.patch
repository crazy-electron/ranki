+    /// The skipped set describes server files only; it must never generate a local deletion.
+    pub(crate) fn configure_audio_sync(&mut self, skip_audio: bool) -> error::Result<()> {
+        let has_policy: bool = self.db.query_row(
+            "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='ranki_audio_policy')",
+            [], |row| row.get(0),
+        )?;
+        if !has_policy && !skip_audio {
+            return Ok(());
+        }
+        if skip_audio {
+            use rusqlite::functions::FunctionFlags;
+            self.db.create_scalar_function(
+                "ranki_is_audio",
+                1,
+                FunctionFlags::SQLITE_UTF8 | FunctionFlags::SQLITE_DETERMINISTIC,
+                |ctx| Ok(is_audio_filename(ctx.get_raw(0).as_str()?)),
+            )?;
+        }
+        self.non_audio_usn = self.transact(|ctx| {
+            if !has_policy {
+                ctx.db.execute_batch(
+                    "CREATE TABLE ranki_audio_policy (skipping INTEGER NOT NULL, nonAudioUsn INTEGER NOT NULL);
+                     INSERT INTO ranki_audio_policy VALUES (0, 0)",
+                )?;
+            }
+            let (previous, mut floor): (bool, Usn) = ctx.db.query_row(
+                "SELECT skipping, nonAudioUsn FROM ranki_audio_policy",
+                [],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )?;
+            if previous != skip_audio {
+                if skip_audio {
+                    ctx.db.execute_batch("CREATE TABLE ranki_remote_audio (fname TEXT PRIMARY KEY NOT NULL) WITHOUT ROWID")?;
+                } else {
+                    ctx.db.execute_batch("DROP TABLE ranki_remote_audio")?;
+                }
+                // Replay old audio records without reapplying old server images over
+                // pending local edits. Keep the floor if a replay was interrupted.
+                floor = floor.max(ctx.get_meta()?.last_sync_usn);
+                ctx.db.execute("UPDATE ranki_audio_policy SET skipping=?, nonAudioUsn=?", params![skip_audio, floor])?;
+                ctx.db.execute("UPDATE meta SET lastUsn = 0", [])?;
+            }
+            Ok(floor)
+        })?;
+        self.skip_audio = skip_audio;
+        Ok(())
+    }
