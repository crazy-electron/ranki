+#[tokio::test]
+async fn ranki_audio_policy_preserves_cloud_media_and_backfills_on_disable() -> Result<()> {
+    with_active_server(|client| async move {
+        let ctx = SyncTestContext::new(client.clone());
+        let desktop = ctx.media1();
+        let kindle = ctx.media2();
+        let marker = kindle.media_folder.with_extension("ranki-no-audio");
+        // A real audio file downloaded before the setting was enabled.
+        desktop.add_file("cached.mp3", b"old recording")?;
+        desktop.add_file("local.jpg", b"original image")?;
+        desktop.add_file("deleted.png", b"delete me")?;
+        ctx.sync_media1().await?;
+        ctx.sync_media2().await?;
+        kindle.remove_files(&["local.jpg"])?;
+        kindle.add_file("local.jpg", b"edited before enabling")?;
+        fs::write(&marker, b"")?;
+
+        desktop.add_file("remote.MP3", b"recording")?;
+        desktop.add_file("obsolete.ogg", b"other recording")?;
+        desktop.add_file("picture.png", b"first image")?;
+        ctx.sync_media1().await?;
+        ctx.sync_media2().await?;
+        ctx.sync_media1().await?;
+        assert_eq!(
+            fs::read(desktop.media_folder.join("local.jpg"))?,
+            b"edited before enabling"
+        );
+        assert!(!kindle.media_folder.join("remote.MP3").exists());
+        assert!(!kindle.media_folder.join("obsolete.ogg").exists());
+        assert_eq!(
+            fs::read(kindle.media_folder.join("picture.png"))?,
+            b"first image"
+        );
+        assert_eq!(
+            fs::read(kindle.media_folder.join("cached.mp3"))?,
+            b"old recording"
+        );
+
+        desktop.remove_files(&["obsolete.ogg".to_string()])?;
+        desktop.remove_files(&["remote.MP3".to_string()])?;
+        desktop.add_file("remote.MP3", b"new recording")?;
+        kindle.remove_files(&["cached.mp3".to_string()])?;
+        kindle.add_file("edited.jpg", b"kindle image")?;
+        ctx.sync_media1().await?;
+        ctx.sync_media2().await?;
+        ctx.sync_media1().await?;
+        assert_eq!(
+            fs::read(desktop.media_folder.join("cached.mp3"))?,
+            b"old recording"
+        );
+        assert_eq!(
+            fs::read(desktop.media_folder.join("edited.jpg"))?,
+            b"kindle image"
+        );
+
+        // No new server changes: disabling still has to fetch skipped files.
+        kindle.remove_files(&["deleted.png"])?;
+        fs::remove_file(marker)?;
+        ctx.sync_media2().await?;
+        assert_eq!(
+            fs::read(kindle.media_folder.join("remote.MP3"))?,
+            b"new recording"
+        );
+        assert_eq!(
+            fs::read(kindle.media_folder.join("cached.mp3"))?,
+            b"old recording"
+        );
+        assert!(!kindle.media_folder.join("obsolete.ogg").exists());
+        ctx.sync_media1().await?;
+        assert!(!desktop.media_folder.join("deleted.png").exists());
+        ctx.sync_media2().await?;
+        Ok(())
+    })
+    .await
+}
